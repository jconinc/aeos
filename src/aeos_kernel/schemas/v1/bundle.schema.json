{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeos.local/schemas/v1/bundle.schema.json",
  "title": "AEOS v1 contract bundle",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "revision", "digest"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/Digest"}
      }
    },
    "DecisionSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertical_id", "tenant_id", "subject_id", "subject_kind", "revision",
        "content_digest", "attributes", "source_refs", "privacy_classification", "allowed_uses"
      ],
      "properties": {
        "vertical_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_kind": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/Digest"},
        "attributes": {"type": "object"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/SourceRef"}},
        "privacy_classification": {
          "enum": ["public", "internal", "restricted", "prohibited"]
        },
        "allowed_uses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "evidence_digest", "source_tier", "vertical_id", "tenant_id",
        "subject_id", "subject_revision", "payload", "source_ref", "observed_at", "expires_at",
        "privacy_classification", "allowed_uses", "research_receipt_digest"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/Digest"},
        "source_tier": {"type": "string", "minLength": 1},
        "vertical_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "string", "minLength": 1},
        "payload": {"type": "object"},
        "source_ref": {"$ref": "#/$defs/SourceRef"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "privacy_classification": {
          "enum": ["public", "internal", "restricted", "prohibited"]
        },
        "allowed_uses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "research_receipt_digest": {
          "oneOf": [{"const": ""}, {"$ref": "#/$defs/Digest"}]
        }
      }
    },
    "AuthorityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "policy_version", "level", "intensity", "allowed_boundary_tags",
        "required_capacity", "requires_human_attestation", "permits_model_choice",
        "max_model_calls", "max_model_cost_minor_units"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "level": {
          "enum": ["deterministic", "standard_default", "agent_judgment", "human_required"]
        },
        "intensity": {"type": "integer", "minimum": 0, "maximum": 2},
        "allowed_boundary_tags": {
          "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
        },
        "required_capacity": {"type": "string"},
        "requires_human_attestation": {"type": "boolean"},
        "permits_model_choice": {"type": "boolean"},
        "max_model_calls": {"type": "integer", "minimum": 0},
        "max_model_cost_minor_units": {"type": "integer", "minimum": 0}
      }
    },
    "DecisionPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "packet_id", "packet_digest", "subject", "evidence",
        "authority_bundle_digest", "policy", "allowed_actions", "source_head_pins",
        "adapter_id", "adapter_version", "created_at"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "packet_id": {"type": "string", "minLength": 1},
        "packet_digest": {"$ref": "#/$defs/Digest"},
        "subject": {"$ref": "#/$defs/DecisionSubject"},
        "evidence": {
          "type": "array", "items": {"$ref": "#/$defs/EvidenceItem"}
        },
        "authority_bundle_digest": {"$ref": "#/$defs/Digest"},
        "policy": {"$ref": "#/$defs/AuthorityPolicy"},
        "allowed_actions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_head_pins": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "EntailmentProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_tier", "cited_evidence_ids", "reason", "claimed_entailed"],
      "properties": {
        "source_tier": {"type": "string", "minLength": 1},
        "cited_evidence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1},
        "claimed_entailed": {"type": "boolean"}
      }
    },
    "EffectTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "parameters", "boundary_tags", "expected_postcondition", "reversible",
        "compensation_ref", "cost_ceiling_minor_units"
      ],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "boundary_tags": {
          "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
        },
        "expected_postcondition": {"type": "string", "minLength": 1},
        "reversible": {"type": "boolean"},
        "compensation_ref": {"type": "string"},
        "cost_ceiling_minor_units": {"type": "integer", "minimum": 0}
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "action", "title", "explanation", "proof", "expected_benefit",
        "uncertainty", "effect"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "proof": {"$ref": "#/$defs/EntailmentProof"},
        "expected_benefit": {"type": "string"},
        "uncertainty": {"type": "string"},
        "effect": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/EffectTemplate"}]}
      }
    },
    "ModelCallIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "model_id", "prompt_digest", "generation_parameters_digest", "attempt",
        "cost_minor_units"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "prompt_digest": {"$ref": "#/$defs/Digest"},
        "generation_parameters_digest": {"$ref": "#/$defs/Digest"},
        "attempt": {"type": "integer", "minimum": 1},
        "cost_minor_units": {"type": "integer", "minimum": 0}
      }
    },
    "Refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "missing_premise"],
      "properties": {
        "code": {
          "enum": [
            "invalid_packet", "invalid_evidence", "stale_input", "cross_scope_evidence",
            "authority_missing", "authority_conflict", "no_eligible_candidate",
            "ambiguous_entailment", "model_required", "model_invalid", "model_disagreement",
            "model_budget_exceeded", "human_required", "human_attestation_invalid",
            "boundary_not_authorized", "effect_not_registered", "effect_precondition_failed",
            "conflict"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "missing_premise": {"type": "string"}
      }
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id", "decision_revision", "status", "packet_digest", "candidate_set_digest",
        "selected_candidate_id", "selection_mode", "explanation", "evidence_ids",
        "rejected_alternatives", "model_calls", "model_outputs", "refusal"
      ],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "decision_revision": {"type": "integer", "minimum": 1},
        "status": {
          "enum": [
            "proposed", "accepted", "applying", "applied", "verified_closed", "apply_failed",
            "verifier_failed", "stale", "superseded", "refused", "human_required"
          ]
        },
        "packet_digest": {"$ref": "#/$defs/Digest"},
        "candidate_set_digest": {"$ref": "#/$defs/Digest"},
        "selected_candidate_id": {"type": "string"},
        "selection_mode": {"type": "string"},
        "explanation": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rejected_alternatives": {
          "type": "array", "items": {"type": "string", "minLength": 1}
        },
        "model_calls": {"type": "array", "items": {"$ref": "#/$defs/ModelCallIdentity"}},
        "model_outputs": {"type": "array", "items": {"type": "object"}},
        "refusal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Refusal"}]}
      }
    },
    "HumanAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id", "actor_id", "capacity", "decision_id", "decision_revision",
        "recommendation_digest", "subject_digest", "projection_digest", "response",
        "idempotency_key", "decided_at", "note", "snooze_until"
      ],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "actor_id": {"type": "string", "minLength": 1},
        "capacity": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "decision_revision": {"type": "integer", "minimum": 1},
        "recommendation_digest": {"$ref": "#/$defs/Digest"},
        "subject_digest": {"$ref": "#/$defs/Digest"},
        "projection_digest": {"$ref": "#/$defs/Digest"},
        "response": {"enum": ["use_this", "change_it", "not_now", "snooze"]},
        "idempotency_key": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"},
        "snooze_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "AuthorizedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id", "decision_id", "decision_revision", "operation", "parameters",
        "boundary_tags", "precondition_digest", "expected_postcondition", "idempotency_key",
        "authorized_at", "authority_policy_digest", "attestation_id", "compensation_ref",
        "cost_ceiling_minor_units"
      ],
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "decision_revision": {"type": "integer", "minimum": 1},
        "operation": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "boundary_tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "precondition_digest": {"$ref": "#/$defs/Digest"},
        "expected_postcondition": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"},
        "authority_policy_digest": {"$ref": "#/$defs/Digest"},
        "attestation_id": {"type": "string"},
        "compensation_ref": {"type": "string"},
        "cost_ceiling_minor_units": {"type": "integer", "minimum": 0}
      }
    },
    "EffectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id", "authorization_id", "decision_id", "decision_revision", "operation",
        "request_digest", "status", "applied_at", "result_refs", "actual_postimage_digest",
        "external_confirmation_ref", "safe_diagnostic"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "authorization_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "decision_revision": {"type": "integer", "minimum": 1},
        "operation": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "#/$defs/Digest"},
        "status": {"enum": ["applied", "failed", "indeterminate"]},
        "applied_at": {"type": "string", "format": "date-time"},
        "result_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actual_postimage_digest": {
          "oneOf": [{"const": ""}, {"$ref": "#/$defs/Digest"}]
        },
        "external_confirmation_ref": {"type": "string"},
        "safe_diagnostic": {"type": "string"}
      }
    },
    "OutcomeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id", "receipt_id", "metric_id", "status", "window_started_at",
        "window_ended_at", "observed_at", "aggregate", "policy_digest", "evidence_digest"
      ],
      "properties": {
        "outcome_id": {"type": "string", "minLength": 1},
        "receipt_id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["positive", "negative", "neutral", "insufficient_evidence"]},
        "window_started_at": {"type": "string", "format": "date-time"},
        "window_ended_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "aggregate": {"type": "object"},
        "policy_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/Digest"}]},
        "evidence_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/Digest"}]}
      }
    }
  }
}
